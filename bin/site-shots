#!/bin/sh
# Pictures of the window for the website, on Hyprland:
#   bin/site-shots ~/trance-media/shots [panel...]
#
# Opens Trance on settings of its own (yours are left alone), floats it at
# 1200x750 in the middle of the screen, opens each panel with its key and
# takes three pictures of it with grim, 0.4 s apart, to pick the best from:
#
#   editor-1..3.png     Louche in the editor, on the Motion tab, where its
#                       warp is a formula of the bass
#   settings-1..3.png   over Lodestone
#   help-1..3.png       over Crosshatch
#   browser-1..3.png    the preset list, with a few favorites and a list,
#                       over Wisteria
#   glass-1..3.png      glass on over Plumage, so the desktop shows through
#
# The website's alt texts name these presets (src/pages/index.astro in
# trance-site): change them there too.
#
# Name panels to take only those: after adding presets, `browser` alone is
# enough, since it is the one that says how many there are. The site keeps
# the pictures it isn't given anew.
#
# Needs a built trance (bin/build), hyprctl, grim, jq and wtype, and music
# playing.
set -eu

PANELS="editor settings help browser glass"
if [ $# -lt 1 ]; then
  echo "Usage: bin/site-shots <out-dir> [$(echo $PANELS | tr ' ' '|')]..." >&2
  exit 2
fi
OUT_ARG="$1"
shift
WANTED="${*:-$PANELS}"
for panel in $WANTED; do
  case " $PANELS " in
    *" $panel "*) ;;
    *) echo "No panel called $panel: one of $PANELS." >&2; exit 2 ;;
  esac
done
want() {
  case " $WANTED " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
TRANCE="$ROOT/build/trance"
for tool in hyprctl grim jq wtype; do
  command -v "$tool" >/dev/null || { echo "bin/site-shots needs $tool." >&2; exit 1; }
done
[ -x "$TRANCE" ] || { echo "Build trance first: bin/build" >&2; exit 1; }
WINDOW="class:trance"
if [ "$(hyprctl clients -j | jq '[.[] | select(.class == "trance")] | length')" != 0 ]; then
  echo "Close Trance first: the pictures start from a window of their own." >&2
  exit 1
fi
mkdir -p "$OUT_ARG"
OUT="$(realpath -- "$OUT_ARG")"

cat <<'EOF'
Play some music now and leave it playing: Trance moves with what it hears,
and the pictures need it moving. The window opens on an empty workspace,
where the glass pictures show the wallpaper through it. Leave the mouse alone
until it is done, so the controls stay hidden.
EOF
printf 'Press Enter when the music is playing. '
read -r _

# Held on one preset, colors drifting, no track names in the picture.
CONFIG="$(mktemp -d)"
mkdir "$CONFIG/trance"
cat >"$CONFIG/trance/settings.ini" <<'EOF'
[General]
locked=true
colorDrift=true
glass=false
titleStyle=off
EOF
# A few favorites and a list of one's own, for the browser to show its stars
# and lists.
cat >"$CONFIG/trance/lists.json" <<'EOF'
{ "lists": [
  { "name": "Favorites", "presets": ["Aurora", "Borehole", "Corona", "Heath", "Jellyfish", "Lodestone", "Nebula", "Spillway"] },
  { "name": "Late night", "presets": ["Borehole", "Ink Well", "Louche", "Nebula", "Undertow"] }
] }
EOF
XDG_CONFIG_HOME="$CONFIG" "$TRANCE" open Wisteria >/dev/null 2>&1 &
PID=$!
trap 'kill $PID 2>/dev/null; rm -rf "$CONFIG"' EXIT

dispatch() {
  said="$(hyprctl dispatch "$1")" || { echo "hyprctl: $said" >&2; exit 1; }
}
key() {
  dispatch "hl.dsp.send_shortcut({ mods = \"$1\", key = \"$2\", window = \"$WINDOW\" })"
  sleep "${3:-1}"
}
# Hyprland's shortcuts don't make Qt's "?", so that one is typed, into the
# window only.
question() {
  if [ "$(hyprctl activewindow -j | jq -r .class)" != trance ]; then
    echo "Trance lost the focus, so ? was not typed." >&2
    exit 1
  fi
  wtype '?'
  sleep 1
}
geometry() {
  hyprctl clients -j | jq -r '.[] | select(.class == "trance") | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}
# Each panel over a preset of its own: the window changes to it, and the
# trails build up again before the panel opens.
preset() {
  XDG_CONFIG_HOME="$CONFIG" "$TRANCE" preset "$1" >/dev/null || { echo "Trance didn't change to $1." >&2; exit 1; }
  sleep 7
}
shoot() {
  for i in 1 2 3; do
    grim -g "$(geometry)" "$OUT/$1-$i.png"
    [ "$i" = 3 ] || sleep 0.4
  done
  echo "Took $1"
}

waited=0
until [ -n "$(geometry)" ]; do
  waited=$((waited + 1))
  [ "$waited" -le 50 ] || { echo "Trance's window never came up." >&2; exit 1; }
  sleep 0.2
done
dispatch "hl.dsp.window.move({ workspace = \"empty\", window = \"$WINDOW\" })"
dispatch "hl.dsp.window.float({ action = \"enable\", window = \"$WINDOW\" })"
dispatch "hl.dsp.window.resize({ x = 1200, y = 750, window = \"$WINDOW\" })"
dispatch "hl.dsp.window.center({ window = \"$WINDOW\" })"
# Past the hint and the logo the window gives at first.
sleep 8
case "$(geometry)" in
  *" 1200x750") ;;
  *) echo "The window is $(geometry), not 1200x750; going on." >&2 ;;
esac

if want editor; then
  preset Louche
  key "" E
  shoot editor
  key "" E
fi
if want settings; then
  preset Lodestone
  key "" S
  shoot settings
  key "" S
fi
if want help; then
  preset Crosshatch
  question
  shoot help
  question
fi
if want browser; then
  preset Wisteria
  key "" P
  shoot browser
  # P opens the list without the search field taking the keys, so P closes
  # it again (Escape would too, and a P after it open the list once more).
  key "" P
fi
if want glass; then
  preset Plumage
  # Past the toast that says glass is on.
  key "" G 3
  shoot glass
fi
