#!/bin/sh
# Renders presets into one tiled picture for the README:
#   bin/gallery docs/gallery.jpg 4 "Neon Tunnel" Whitecaps ...
# The number is how many tiles to a row. Needs a built trance (bin/build)
# and ImageMagick's magick.
set -eu

if [ $# -lt 3 ]; then
  echo "Usage: bin/gallery <output.jpg> <columns> <preset>..." >&2
  exit 2
fi
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
OUT="$1"
COLUMNS="$2"
shift 2
TILES="$(mktemp -d)"
trap 'rm -rf "$TILES"' EXIT

# Twelve seconds into the built-in test loop, so the trails have built up.
n=0
for preset in "$@"; do
  n=$((n + 1))
  "$ROOT/build/trance" render "$preset" -o "$TILES/$(printf %03d $n).png" \
    --size 640x360 --seconds 12 >/dev/null
done

magick montage "$TILES"/*.png -tile "${COLUMNS}x" -geometry +3+3 -background '#141414' \
  -quality 86 "$OUT"
echo "Wrote $OUT"
