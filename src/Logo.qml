import QtQuick
import QtQuick.Shapes

// The wordmark with the app icon's five bars behind it, as the website and
// the README have it. The bars move to the sound the way the website's do:
// all of them jump on the kick, and each also follows one range, low on the
// left to high on the right, the last taking the air too.
Item {
    id: logo
    // The beat, which jumps to 1 and falls away, and the six ranges' _att.
    property real kick: 0
    property var bands: []

    // Tall enough for the tallest bar at its tallest.
    implicitWidth: 840
    implicitHeight: 560
    // Drawn once at its own size and scaled, smoothed by drawing it several
    // times over: a Shape's curves have rough edges otherwise.
    layer.enabled: true
    layer.samples: 4

    Item {
        // The README's banner is 1600 by 560; what is drawn of it is this.
        x: -380 * logo.width / logo.implicitWidth
        transform: Scale { xScale: logo.width / logo.implicitWidth; yScale: logo.height / logo.implicitHeight }

        Repeater {
            model: [127.27, 290.91, 400, 236.36, 90.91]
            Rectangle {
                required property int index
                required property real modelData
                readonly property real heard: index === 4 ? Math.max(logo.bands[4] || 0, logo.bands[5] || 0)
                                                          : (logo.bands[index] || 0)
                x: 609.09 + 81.82 * index
                y: 280 - height / 2
                width: 54.55
                height: modelData * (1 + 0.2 * logo.kick + 0.2 * Math.max(0, Math.min(1, (heard - 0.8) / 2.5)))
                // The levels come twenty times a second, and are gone
                // between rather than stepped to.
                Behavior on height { NumberAnimation { duration: 50 } }
                radius: width / 2
                color: "#ffd60a"
                opacity: 0.45 + 0.3 * logo.kick
            }
        }

        Shape {
            ShapePath {
                fillColor: "#ecebf3"
                strokeColor: "transparent"
