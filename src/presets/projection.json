{
  "name": "Projection",
  "author": "Trance",
  "description": "A globe of the spectrum projected into the air above a ring of light, the way films imagine holograms: it turns slowly, flickers through every color of the foil, and breaks up into bands and fringes when the beat lands.",
  "palette": "hologram",
  "init": "ph = rand(6)\ndir = rand() < 0.5 ? -1 : 1",
  "frame": "spin = spin + dir*dt*(0.2 + 0.25*min(mid_att, 2))",
  "feedback": {
    "decay": 0.7,
    "dy": 0.002,
    "edge": "black"
  },
  "background": {
    "style": "grid",
    "intensity": 0.08,
    "tint": 0.2,
    "spread": 0.4,
    "scale": 2,
    "speed": 0.2
  },
  "layers": [
    {
      "type": "wireframe",
      "form": "sphere",
      "style": "lines",
      "bins": 48,
      "rows": 32,
      "speed": 16,
      "low": 60,
      "high": 9000,
      "smooth": 0.4,
      "fade": 0.5,
      "height": 0.18,
      "radius": "0.5 + 0.03*min(bass_att, 2)",
      "yaw": "spin + ph",
      "pitch": 0.35,
      "distance": 3.2,
      "y": 0.12,
      "thickness": 1.4,
      "fog": 0.5,
      "color": "palette(t + time*0.08)",
      "alpha": 0.8
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 128,
      "point": "th = t*tau\nx = (0.5 + 0.02*v)*cos(th)\ny = -0.72 + 0.09*sin(th)",
      "thickness": 3,
      "color": "palette(t + time*0.08 + 0.3)",
      "alpha": 0.9
    },
    {
      "type": "particles",
      "emit": "point",
      "x": 0,
      "y": -0.72,
      "area": 0.45,
      "count": 900,
      "rate": "120 + 300*min(treb_att, 2)",
      "speed": 0.02,
      "gravity": -0.5,
      "drag": 0.8,
      "life": 2,
      "size": 1.6,
      "color": "palette(i + time*0.08)",
      "alpha": 0.5,
      "blend": "add"
    }
  ],
  "post": {
    "bloom": 0.9,
    "bloomThreshold": 0.4,
    "chroma": "0.3 + 1.6*beat",
    "scanlines": 0.35,
    "vignette": 0.5
  }
}
