      "speed": 0.06,
      "flow": 1,
      "life": 1.8,
      "size": 1.8,
      "color": "palette(i)",
      "alpha": 0.8
    }
  ],
  "post": {
    "bloom": 0.9,
    "vignette": 0.45
  }
}
