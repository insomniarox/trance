{
  "name": "Loom",
  "author": "Trance",
  "description": "A cloth being woven: heavy threads running up the screen for the rumble, the bass and the low mids, fine ones running across for the leads, the snares and the cymbals. Each set billows with its own range.",
  "palette": "theme",
  "frame": "p0 = p0 + dt*0.50*(0.3 + 0.8*sub_att)\np1 = p1 + dt*0.95*(0.3 + 0.8*low_att)\np2 = p2 + dt*1.40*(0.3 + 0.8*lowmid_att)\np3 = p3 + dt*1.85*(0.3 + 0.8*highmid_att)\np4 = p4 + dt*2.30*(0.3 + 0.8*presence_att)\np5 = p5 + dt*2.75*(0.3 + 0.8*air_att)",
  "feedback": {
    "decay": 0.86,
    "zoom": 1.004,
    "blur": 0.2,
    "edge": "black"
  },
  "layers": [
    {
      "type": "wave",
      "shape": "custom",
      "samples": 384,
      "thickness": "7*(0.6 + 0.45*sub)",
      "color": "palette(0.00 + 0.04*sin(time*0.2))",
      "alpha": "clamp(0.25 + 0.4*sub_att, 0, 1)",
      "point": "ln = floor(t*3*0.9999)\nu = t*3 - ln\nu = if(equal(mod(ln, 2), 0), u, 1 - u)\noff = 0.11*min(sub_att, 2)*sin(u*3 + p0 + ln*1.7) + v*0.015\nx = ((ln + 0.5)/3*2 - 1)*aspect*0.92 + off\ny = (u*2 - 1)*1.08"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 384,
      "thickness": "5.5*(0.6 + 0.45*low)",
      "color": "palette(0.17 + 0.04*sin(time*0.2))",
      "alpha": "clamp(0.25 + 0.4*low_att, 0, 1)",
      "point": "ln = floor(t*4*0.9999)\nu = t*4 - ln\nu = if(equal(mod(ln, 2), 0), u, 1 - u)\noff = 0.09*min(low_att, 2)*sin(u*4.5 + p1 + ln*1.7) + v*0.015\nx = ((ln + 0.5)/4*2 - 1)*aspect*0.92 + off\ny = (u*2 - 1)*1.08"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 384,
      "thickness": "4.5*(0.6 + 0.45*lowmid)",
      "color": "palette(0.33 + 0.04*sin(time*0.2))",
      "alpha": "clamp(0.25 + 0.4*lowmid_att, 0, 1)",
      "point": "ln = floor(t*5*0.9999)\nu = t*5 - ln\nu = if(equal(mod(ln, 2), 0), u, 1 - u)\noff = 0.07*min(lowmid_att, 2)*sin(u*6 + p2 + ln*1.7) + v*0.015\nx = ((ln + 0.5)/5*2 - 1)*aspect*0.92 + off\ny = (u*2 - 1)*1.08"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 384,
      "thickness": "3.2*(0.6 + 0.45*highmid)",
      "color": "palette(0.50 + 0.04*sin(time*0.2))",
      "alpha": "clamp(0.25 + 0.4*highmid_att, 0, 1)",
      "point": "ln = floor(t*5*0.9999)\nu = t*5 - ln\nu = if(equal(mod(ln, 2), 0), u, 1 - u)\noff = 0.05*min(highmid_att, 2)*sin(u*9 + p3 + ln*1.7) + v*0.015\nx = (u*2 - 1)*aspect*1.06\ny = ((ln + 0.5)/5*2 - 1)*0.92 + off"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 384,
      "thickness": "2.4*(0.6 + 0.45*presence)",
      "color": "palette(0.67 + 0.04*sin(time*0.2))",
      "alpha": "clamp(0.25 + 0.4*presence_att, 0, 1)",
      "point": "ln = floor(t*7*0.9999)\nu = t*7 - ln\nu = if(equal(mod(ln, 2), 0), u, 1 - u)\noff = 0.04*min(presence_att, 2)*sin(u*13 + p4 + ln*1.7) + v*0.015\nx = (u*2 - 1)*aspect*1.06\ny = ((ln + 0.5)/7*2 - 1)*0.92 + off"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 384,
      "thickness": "1.8*(0.6 + 0.45*air)",
      "color": "palette(0.83 + 0.04*sin(time*0.2))",
