{
  "name": "Vinyl",
  "author": "Trance",
  "description": "A record seen from above as it plays: every groove is a moment of the music, cut at the label and spiralling out to the rim.",
  "palette": "twilight",
  "init": "ph = rand(6)",
  "feedback": {
    "decay": 0.7,
    "rot": 0.004,
    "blur": 0.2,
    "edge": "black"
  },
  "layers": [
    {
      "type": "wireframe",
      "form": "ring",
      "style": "lines",
      "bins": 128,
      "rows": 48,
      "speed": 14,
      "low": 60,
      "high": 5000,
      "smooth": 0.4,
      "fade": 0.25,
      "height": "0.18 + 0.05*bass_att",
      "radius": 1.45,
      "yaw": "-time*0.6",
      "pitch": "1.05 + 0.15*sin(time*0.11 + ph)",
      "roll": "0.12*sin(time*0.07)",
      "distance": 3.6,
      "y": -0.05,
      "thickness": 1.3,
      "fog": 0.5,
      "color": "palette(0.15 + 0.7*i + 0.25*min(v, 1))",
      "alpha": 0.85
    },
    {
      "type": "shape",
      "sides": 48,
      "y": -0.05,
      "radius": "0.2 + 0.02*beat",
      "color": "palette(0.55 + 0.05*sin(time*0.3))",
      "alpha": 0.7,
      "color2": "palette(0.45)",
      "alpha2": 0.15,
      "blend": "add"
    }
  ],
  "post": {
    "bloom": 0.8,
    "bloomThreshold": 0.45,
    "vignette": 0.45
  }
}
