{
  "name": "Taffy",
  "author": "Trance",
  "description": "A candy puller: a rope of pastel sugar looped round two turning arms, folded and drawn out again on the loudness and squeezed on every beat. Nothing moves underneath; only the rope.",
  "palette": "candy",
  "frame": "pull = pull + dt*(0.4 + 0.9*min(vol_att, 2))\nsq = max(sq*0.9, beat)",
  "feedback": {
    "decay": 0.55,
    "blur": 0.2,
    "edge": "black"
  },
  "background": {
    "style": "gradient",
    "intensity": 0.25,
    "tint": 0.6,
    "spread": 0.5,
    "speed": 0.2
  },
  "layers": [
    {
      "type": "shape",
      "sides": 32,
      "instances": 90,
      "x": "0.75*aspect*0.55*sin(t*tau + pull)*(1 + 0.25*cos(pull*0.5))",
      "y": "0.38*sin(2*(t*tau + pull))*(1 - 0.3*sq)",
      "radius": "0.075*(1 + 0.25*sq)*(0.85 + 0.3*min(v*2, 1))",
      "color": "palette(t*3 + pull*0.05)",
      "alpha": 0.5,
      "color2": "palette(t*3 + pull*0.05 + 0.1)",
      "alpha2": 0.8,
      "blend": "over"
    },
    {
      "type": "shape",
      "sides": 16,
      "instances": 90,
      "x": "0.75*aspect*0.55*sin(t*tau + pull)*(1 + 0.25*cos(pull*0.5)) - 0.02",
      "y": "0.38*sin(2*(t*tau + pull))*(1 - 0.3*sq) + 0.025",
      "radius": 0.018,
      "color": "white",
      "alpha": 0.6,
      "color2": "white",
      "alpha2": 0,
      "blend": "add"
    },
    {
      "type": "shape",
      "sides": 6,
      "instances": 2,
      "x": "(2*n - 1)*0.42*aspect*0.55",
      "radius": 0.06,
      "angle": "pull*(2*n - 1)",
      "color": "palette(0.6)",
      "alpha": 0.6,
      "border": "white",
      "borderAlpha": 0.7,
      "borderWidth": 2,
      "blend": "over"
    }
  ],
  "post": {
    "bloom": 0.3,
    "bloomThreshold": 0.75,
    "saturation": 1.05,
    "vignette": 0.35
  }
}
