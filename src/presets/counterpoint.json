{
  "name": "Counterpoint",
  "author": "Trance",
  "description": "Two figures that each listen to half of the music: a wide floor that only hears the bass and the drums, and a globe above it that only hears the voices and the cymbals.",
  "palette": "steel",
  "init": "ph = rand(6)\ndir = rand() < 0.5 ? -1 : 1",
  "feedback": {
    "decay": 0.72,
    "blur": 0.25,
    "edge": "black"
  },
  "layers": [
    {
      "type": "wireframe",
      "form": "ring",
      "style": "mesh",
      "bins": 64,
      "rows": 30,
      "speed": 14,
      "low": 30,
      "high": 400,
      "tilt": 2,
      "smooth": 0.45,
      "fade": 0.35,
      "height": "0.3 + 0.1*bass_att",
      "radius": 1.9,
      "yaw": "dir*time*0.07 + ph",
      "pitch": 0.32,
      "distance": 3.2,
      "y": -0.42,
      "thickness": 1.2,
      "fog": 0.8,
      "color": "palette(0.2 + 0.5*min(v, 1))",
      "alpha": 0.75
    },
    {
      "type": "wireframe",
      "form": "sphere",
      "style": "lines",
      "bins": 56,
      "rows": 20,
      "speed": 12,
      "low": 1500,
      "high": 12000,
      "tilt": 4,
      "smooth": 0.25,
      "fade": 0.3,
      "height": "0.18 + 0.06*treb_att",
      "radius": 0.32,
      "yaw": "-dir*time*0.3 + ph",
      "pitch": "0.3 + 0.2*sin(time*0.1)",
      "distance": 3.2,
      "y": 0.42,
      "size": 0.9,
      "thickness": 1.3,
      "fog": 0.7,
      "color": "palette(0.45 + 0.4*min(v, 1))",
      "alpha": 0.65
    }
  ],
  "post": {
    "bloom": 0.7,
    "bloomThreshold": 0.5,
    "vignette": 0.45
  }
}
