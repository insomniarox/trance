{
  "name": "Apogee",
  "author": "Trance",
  "description": "A vector-display night in pencil grays: a wire moon turns high over a grid running out between two ranges of hills, and the ground streams toward you. The floor down the middle is the music, rolling in from the horizon; the hills lean in a little on the bass, the moon's surface stirs with the voices and throws sparks on the beat, and the kick drives you faster.",
  "palette": "graphite",
  "frame": "spd = 9 + 5*min(bass_att, 2)",
  "pixel": "zoom = 1 + (0.005 + 0.006*min(bass_att, 2))*smoothstep(-0.03, -0.38, y)",
  "feedback": {
    "decay": 0.86,
    "cy": -0.03,
    "blur": 0.1,
    "edge": "black"
  },
  "layers": [
    {
      "type": "shape",
      "sides": 64,
      "x": "0.42*aspect",
      "y": 0.5,
      "radius": 0.62,
      "color": "palette(0.9)",
      "alpha": "0.3 + 0.1*min(highmid_att, 2)",
      "color2": "palette(0.9)",
      "alpha2": 0,
      "blend": "max"
    },
    {
      "type": "wave",
      "shape": "line",
      "y": -0.03,
      "scale": 0.01,
      "smooth": 0.9,
      "thickness": 36,
      "color": "palette(0.8)",
      "alpha": 0.35,
      "blend": "max"
    },
    {
      "type": "wave",
      "shape": "line",
      "y": -0.03,
      "scale": 0,
      "thickness": "2 + 4*beat",
      "color": "palette(0.95)",
      "alpha": "0.5 + 0.5*beat",
      "blend": "add",
      "width": "0.6/aspect",
      "point": "a = a*smoothstep(0, 0.6, 1 - abs(t*2 - 1))"
    },
    {
      "type": "wireframe",
      "form": "sphere",
      "style": "lines",
      "bins": 48,
      "rows": 24,
      "speed": 6,
      "radius": 1,
      "height": "0.05 + 0.1*min(highmid_att, 2)",
      "fade": 0.6,
      "yaw": "time*0.12",
      "pitch": 0.35,
      "distance": 4,
      "size": 0.32,
      "x": "0.42*aspect",
      "y": 0.5,
      "fog": 0.8,
      "thickness": 2,
      "color": "palette(0.85 + 0.15*v)",
      "alpha": 0.95,
      "blend": "max"
    },
    {
      "type": "particles",
      "emit": "wave",
      "count": 400,
      "rate": "6 + 500*beat",
      "speed": 0.12,
      "gravity": -0.05,
      "drag": 0.6,
      "field": 0.3,
      "life": 2,
      "size": 1.6,
      "color": "palette(0.9 + 0.1*i)",
      "alpha": 0.8
    },
    {
      "type": "wireframe",
      "form": "sheet",
      "style": "mesh",
      "bins": 64,
      "rows": 32,
      "speed": "spd",
      "height": 1,
      "fade": 0.4,
      "pitch": 0,
      "yaw": 0,
      "distance": 2,
      "size": 2,
      "y": 0.13,
      "fog": 0.6,
      "thickness": 2.2,
      "color": "palette(0.82 + 0.18*min(v, 1))",
      "alpha": 0.95,
      "blend": "max",
      "point": "u = t*2 - 1\nval = smoothstep(0.16, 0.6, abs(u))\nridge = 0.2 + 0.8*noise(u*7, travel*1.2)\nx = u*13\nz = (1 - i)*20\ny = -1 + val*ridge*(3.4 + 0.4*min(bass_att, 2)) + 0.6*v*(1 - val)"
    }
  ],
  "post": {
    "bloom": 1.1,
    "bloomThreshold": 0.45,
    "scanlines": 0.25,
    "grain": 0.06,
    "vignette": 0.5
  }
}
