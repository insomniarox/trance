{
  "name": "Apogee",
  "author": "Trance",
  "description": "A vector-display night in pencil grays: a wire moon turns high over a grid running out between two ranges of hills, and the ground streams toward you. The floor down the middle is the music, rolling in from the horizon; the hills lean in a little on the bass, the moon's surface stirs with the voices, sparks stream off its rim with them and burst outward on the beat, and the kick drives you faster.",
  "palette": "graphite",
  "frame": "drive = 0.28 + 0.16*min(bass_att, 2)",
  "pixel": "zoom = 1 + (0.005 + 0.006*min(bass_att, 2))*smoothstep(-0.03, -0.38, y)",
  "feedback": {
    "decay": 0.86,
    "cy": -0.03,
    "blur": 0.1,
    "edge": "black"
  },
  "layers": [
    {
      "type": "shape",
      "sides": 64,
      "x": "0.42*aspect",
      "y": 0.5,
      "radius": 0.62,
      "color": "palette(0.9)",
      "alpha": "0.3 + 0.1*min(highmid_att, 2)",
      "color2": "palette(0.9)",
      "alpha2": 0,
      "blend": "max"
    },
    {
      "type": "wave",
      "shape": "circle",
      "samples": 128,
      "x": "0.42*aspect",
      "y": 0.5,
      "radius": 0.35,
      "scale": 0.03,
      "smooth": 0.5,
      "alpha": 0
    },
    {
      "type": "particles",
      "emit": "wave",
      "count": 900,
      "rate": "20 + 80*min(highmid_att, 2) + 1000*beat",
      "speed": 0.16,
      "gravity": 0,
      "drag": 0.7,
      "field": 0.25,
      "life": 3,
      "size": 2.2,
      "color": "palette(0.93 + 0.07*i)",
      "alpha": 1,
      "x": "0.42*aspect",
      "y": 0.5,
      "spread": 6.28,
      "pull": "-0.4 - 3*beat",
      "streak": 0.07
    },
    {
      "type": "wireframe",
      "form": "sphere",
      "style": "lines",
      "bins": 48,
      "rows": 24,
      "speed": 6,
      "radius": 1,
      "height": "0.05 + 0.1*min(highmid_att, 2)",
      "fade": 0.6,
      "yaw": "time*0.12",
      "pitch": 0.35,
      "distance": 4,
      "size": 0.32,
      "x": "0.42*aspect",
      "y": 0.5,
      "fog": 0.8,
      "thickness": 2,
      "color": "palette(0.85 + 0.15*v)",
      "alpha": 0.95,
      "blend": "max"
    },
    {
      "type": "wireframe",
      "form": "sheet",
      "style": "mesh",
      "bins": 64,
      "rows": 32,
      "speed": "count*drive",
      "height": 1,
      "fade": 0.4,
      "pitch": 0,
      "yaw": 0,
      "distance": 2,
      "size": 2,
      "y": 0.13,
      "fog": 0.6,
      "thickness": 2.2,
      "color": "palette(0.82 + 0.18*min(v, 1))",
      "alpha": 0.95,
      "blend": "max",
      "point": "u = t*2 - 1\nval = smoothstep(0.16, 0.6, abs(u))\nridge = 0.2 + 0.8*noise(u*7, travel*1.2)\nx = u*13\nz = (1 - i)*20\ny = -1 + val*ridge*(3.4 + 0.4*min(bass_att, 2)) + 0.6*v*(1 - val)"
    }
  ],
  "post": {
    "bloom": 1.1,
    "bloomThreshold": 0.45,
    "scanlines": 0.25,
    "grain": 0.06,
    "vignette": 0.5
  }
}
