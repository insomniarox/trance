{
  "name": "Venetian",
  "author": "Trance",
  "description": "A detective's office after midnight, in black and white: smoke curling up from the music and drifting through the light that falls in bars between the blinds. Only the hardest beats burn red.",
  "palette": "noir",
  "init": "ph = rand(6)",
  "frame": "slat = slat + dt*0.015*(0.5 + min(bass_att, 2))",
  "feedback": {
    "decay": 0.96,
    "dy": 0.003,
    "warp": "0.35 + 0.25*min(mid_att, 2)",
    "warpScale": 1.6,
    "warpSpeed": 0.35,
    "blur": 0.35,
    "edge": "black"
  },
  "layers": [
    {
      "type": "particles",
      "emit": "point",
      "x": "0.35*sin(time*0.11 + ph)",
      "y": -0.95,
      "area": 0.3,
      "count": 4000,
      "rate": "350 + 700*min(bass_att, 2)",
      "speed": 0.22,
      "angle": 1.5708,
      "spread": 0.6,
      "gravity": -0.4,
      "drag": 0.6,
      "field": 1.8,
      "fieldScale": 2.2,
      "fieldSpeed": 0.25,
      "life": 3.5,
      "size": 3.5,
      "color": "palette(0.5 + 0.3*i)",
      "alpha": 0.2,
      "additive": true
    },
    {
      "type": "wave",
      "shape": "line",
      "y": -0.8,
      "width": 1.2,
      "scale": "0.18 + 0.1*min(vol_att, 2)",
      "smooth": 0.6,
      "thickness": 2.5,
      "color": "palette(0.5 + 0.5*min(abs(v)*2, 1))",
      "alpha": "0.25 + 0.6*beat",
      "additive": true
    }
  ],
  "shade": "k = 0.12 + 0.88*smoothstep(0.3, 0.42, fract((y + 0.45*x)*5 + slat))\nr = r*k + 0.06*k\ng = g*k + 0.06*k\nb = b*k + 0.06*k",
  "post": {
    "colorize": 1,
    "colorCurve": 0.75,
    "contrast": 1.15,
    "bloom": 0.35,
    "bloomThreshold": 0.7,
    "vignette": 0.85,
    "grain": 0.12,
    "brightness": "0.85 + 0.35*beat"
  }
}
