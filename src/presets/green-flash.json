{
  "name": "Green Flash",
  "author": "Trance",
  "description": "A striped sun going down into a sea of the spectrum, between two headlands drawn in wire. The sea is the music, rumble on the left to cymbals on the right, rolling out to the horizon with a path of sunlight down the middle and its glow drawn after it; the headlands barely stir. Mist lifts off the horizon where the sound is loud, and on a hard hit the sun's rim flashes green, the way it does in the last second of a real sunset.",
  "palette": "jade",
  "frame": "sunY = 0.24\nsunR = 0.3 + 0.015*min(sub_att, 2)",
  "pixel": "zoom = 1 - 0.006*smoothstep(-0.06, -0.4, y)",
  "feedback": {
    "decay": 0.86,
    "cy": -0.06,
    "blur": 0.1,
    "edge": "black"
  },
  "shade": "sy = y - sunY\ninside = step(length(x, sy), sunR + 0.004)*step(sy, 0.05)\nk = (0.05 - sy)/sunR\ngap = step(fract(k*6 - time*0.12), 0.1 + 0.55*k)\nm = 1 - inside*gap\nr = r*m\ng = g*m\nb = b*m",
  "layers": [
    {
      "type": "shape",
      "sides": 64,
      "x": 0,
      "y": "sunY",
      "radius": "sunR*2.1",
      "color": "palette(0.7)",
      "alpha": "0.4 + 0.15*min(sub_att, 2)",
      "color2": "palette(0.7)",
      "alpha2": 0,
      "blend": "max"
    },
    {
      "type": "wave",
      "shape": "line",
      "y": -0.06,
      "scale": 0.01,
      "smooth": 0.9,
      "thickness": 36,
      "color": "palette(0.65)",
      "alpha": 0.35,
      "blend": "max"
    },
    {
      "type": "shape",
      "sides": 64,
      "y": "sunY",
      "radius": "sunR",
      "color": "palette(0.8)",
      "alpha": 1,
      "color2": "palette(0.55)",
      "alpha2": 0.9,
      "border": "palette(0.95)",
      "borderAlpha": "0.2 + 0.8*beat",
      "borderWidth": "2 + 8*beat",
      "blend": "max"
    },
    {
      "type": "wireframe",
      "form": "sheet",
      "style": "mesh",
      "bins": 72,
      "rows": 10,
      "speed": 1,
      "height": 1,
      "low": 100,
      "high": 3000,
      "fade": 1.5,
      "smooth": 0.8,
      "pitch": 0,
      "yaw": 0,
      "distance": 2,
      "size": 2,
      "y": 0.1,
      "fog": 0.3,
      "thickness": 1.8,
      "color": "palette(0.55 + 0.15*i)",
      "alpha": 0.95,
      "blend": "max",
      "point": "u = t*2 - 1\nx = u*14\nz = 18 + i*6\nhill = smoothstep(0.12, 0.6, abs(u))*(0.3 + 0.7*noise(u*5 + 3.7))*(1 - 0.6*i)\ny = -0.8 + 3.4*hill + 0.12*v\na = a*smoothstep(0.03, 0.12, hill)"
    },
    {
      "type": "wave",
      "shape": "line",
      "y": -0.06,
      "scale": 0.05,
      "smooth": 0.7,
      "thickness": "2 + 4*beat",
      "color": "palette(0.75)",
      "alpha": "0.55 + 0.45*beat",
      "blend": "add"
    },
    {
      "type": "particles",
      "emit": "wave",
      "count": 600,
      "rate": "15 + 400*beat",
      "speed": 0.05,
      "gravity": -0.12,
      "drag": 0.8,
      "field": 0.35,
      "life": 2.2,
      "size": 1.6,
      "color": "palette(0.7 + 0.25*i)",
      "alpha": 0.7
    },
    {
      "type": "terrain",
      "style": "lines",
      "rows": 48,
      "cols": 128,
      "speed": 9,
      "height": "0.14 + 0.08*min(bass_att, 2)",
      "width": 7,
      "y": -1.05,
      "horizon": 0.27,
      "depth": 3,
      "thickness": 1.5,
      "color": "palette(0.5 + 0.35*min(v, 1) + 0.3*(1 - smoothstep(0.02, 0.1, abs(t - 0.5))))",
      "alpha": 1,
      "blend": "max"
    }
  ],
  "post": {
    "bloom": 1.1,
    "bloomThreshold": 0.45,
    "scanlines": 0.2,
    "chroma": 0.25,
    "vignette": 0.45
  }
}
