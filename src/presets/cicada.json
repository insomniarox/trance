{
  "name": "Cicada",
  "author": "Trance",
  "description": "A field at dusk, loud with cicadas. Their song lies along the ground as a band of the spectrum, mirrored, buzzing with the hats and the voices, and the heat carries it up off the field in wavering plumes. Fireflies lift off it on the beat.",
  "palette": "sulfur",
  "feedback": {
    "decay": 0.91,
    "zoom": 1.003,
    "dy": 0.004,
    "warp": 0.35,
    "warpScale": 2,
    "warpSpeed": 0.6,
    "blur": 0.3,
    "edge": "black"
  },
  "background": {
    "style": "gradient",
    "intensity": 0.12,
    "tint": 0.05,
    "spread": 0.3,
    "speed": 0.2
  },
  "layers": [
    {
      "type": "bars",
      "layout": "center",
      "count": 40,
      "x": "-0.5*aspect",
      "y": -0.4,
      "width": 0.5,
      "gap": 0.4,
      "height": "0.22 + 0.1*min(bass_att, 2)",
      "fade": 0.8,
      "peaks": false,
      "color": "palette(0.55 + 0.3*t)",
      "alpha": 0.9,
      "point": "v = v*(0.55 + 0.45*abs(sin(time*47 + i*2.3)))*(0.7 + 0.3*min(highmid_att, 2))\na = 0.4 + 0.6*min(v*2, 1)"
    },
    {
      "type": "wave",
      "shape": "line",
      "y": -0.4,
      "scale": 0.04,
      "smooth": 0.7,
      "thickness": 1.5,
      "color": "palette(0.4)",
      "alpha": 0.5
    },
    {
      "type": "particles",
      "emit": "bars",
      "count": 300,
      "rate": "8 + 150*beat",
      "speed": 0.15,
      "gravity": -0.06,
      "drag": 0.8,
      "flow": 1,
      "field": 0.6,
      "fieldScale": 2,
      "life": 4,
      "size": 3,
      "color": "palette(0.84)",
      "alpha": 0.9
    }
  ],
  "post": {
    "mirror": "x",
    "bloom": 0.8,
    "bloomThreshold": 0.45,
    "vignette": 0.5
  }
}
