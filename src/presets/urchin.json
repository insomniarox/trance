{
  "name": "Urchin",
  "author": "Trance",
  "description": "A turning globe that bristles with whatever is sounding. Each ring of spines is one moment, sinking from the crown to the foot as it fades.",
  "palette": "amethyst",
  "init": "ph = rand(6)\ndir = rand() < 0.5 ? -1 : 1",
  "feedback": {
    "decay": 0.74,
    "zoom": 1.006,
    "rot": "0.002*dir",
    "blur": 0.3,
    "edge": "black"
  },
  "background": {
    "style": "stars",
    "intensity": 0.35,
    "tint": 0.5,
    "spread": 0.3,
    "speed": 0.4
  },
  "layers": [
    {
      "type": "wireframe",
      "form": "sphere",
      "style": "strands",
      "bins": 72,
      "rows": 28,
      "speed": 12,
      "low": 60,
      "high": 4500,
      "fade": 0.4,
      "smooth": 0.2,
      "height": "0.4 + 0.1*bass_att",
      "radius": "0.42 + 0.03*bass_att",
      "yaw": "ph + dir*time*0.25",
      "pitch": "0.35 + 0.3*sin(time*0.15)",
      "roll": "0.25*sin(time*0.11 + ph)",
      "distance": 3,
      "thickness": 1.3,
      "fog": 0.75,
      "color": "palette(0.3 + 0.55*min(v, 1) + 0.15*t)",
      "alpha": 0.6
    }
  ],
  "post": {
    "bloom": 0.6,
    "bloomThreshold": 0.55,
    "vignette": 0.4
  }
}
