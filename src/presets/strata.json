{
  "name": "Strata",
  "author": "Trance",
  "description": "Six seams of sound laid one on another: the rumble rolls slow and thick at the bottom, the shimmer ripples fine at the top, and each moves only to its own range.",
  "palette": "sunset",
  "frame": "p0 = p0 + dt*0.5*(0.3 + 0.9*sub_att)\np1 = p1 + dt*0.8*(0.3 + 0.9*low_att)\np2 = p2 + dt*1.3*(0.3 + 0.9*lowmid_att)\np3 = p3 + dt*2*(0.3 + 0.9*highmid_att)\np4 = p4 + dt*3*(0.3 + 0.9*presence_att)\np5 = p5 + dt*4.5*(0.3 + 0.9*air_att)",
  "feedback": {
    "decay": 0.9,
    "dy": 0.004,
    "blur": 0.35,
    "edge": "black"
  },
  "background": {
    "style": "gradient",
    "intensity": "0.25 + 0.2*sub_att",
    "tint": 0,
    "spread": 0.5,
    "speed": 0.4
  },
  "layers": [
    {
      "type": "wave",
      "shape": "custom",
      "samples": 256,
      "thickness": "10*(0.55 + 0.5*sub)",
      "color": "palette(0.08 + 0.06*t + 0.05*sin(time*0.1))",
      "alpha": "clamp(0.20 + 0.45*sub_att, 0, 1)",
      "point": "x = (t*2 - 1)*aspect*1.05\ny = -0.78 + 0.13*min(sub_att, 1.8)*sin(t*1.25*tau + p0) + v*0.02"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 256,
      "thickness": "7.5*(0.55 + 0.5*low)",
      "color": "palette(0.23 + 0.06*t + 0.05*sin(time*0.1))",
      "alpha": "clamp(0.25 + 0.45*low_att, 0, 1)",
      "point": "x = (t*2 - 1)*aspect*1.05\ny = -0.5 + 0.11*min(low_att, 1.8)*sin(t*2.5*tau + p1) + v*0.02"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 256,
      "thickness": "5.5*(0.55 + 0.5*lowmid)",
      "color": "palette(0.38 + 0.06*t + 0.05*sin(time*0.1))",
      "alpha": "clamp(0.30 + 0.45*lowmid_att, 0, 1)",
      "point": "x = (t*2 - 1)*aspect*1.05\ny = -0.22 + 0.09*min(lowmid_att, 1.8)*sin(t*5*tau + p2) + v*0.02"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 256,
      "thickness": "4.2*(0.55 + 0.5*highmid)",
      "color": "palette(0.53 + 0.06*t + 0.05*sin(time*0.1))",
      "alpha": "clamp(0.35 + 0.45*highmid_att, 0, 1)",
      "point": "x = (t*2 - 1)*aspect*1.05\ny = 0.06 + 0.07*min(highmid_att, 1.8)*sin(t*10*tau + p3) + v*0.02"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 256,
      "thickness": "3.4*(0.55 + 0.5*presence)",
      "color": "palette(0.68 + 0.06*t + 0.05*sin(time*0.1))",
      "alpha": "clamp(0.40 + 0.45*presence_att, 0, 1)",
      "point": "x = (t*2 - 1)*aspect*1.05\ny = 0.34 + 0.05*min(presence_att, 1.8)*sin(t*20*tau + p4) + v*0.02"
    },
    {
      "type": "wave",
      "shape": "custom",
      "samples": 256,
      "thickness": "2.8*(0.55 + 0.5*air)",
      "color": "palette(0.83 + 0.06*t + 0.05*sin(time*0.1))",
      "alpha": "clamp(0.45 + 0.45*air_att, 0, 1)",
      "point": "x = (t*2 - 1)*aspect*1.05\ny = 0.62 + 0.035*min(air_att, 1.8)*sin(t*40*tau + p5) + v*0.02"
    },
    {
      "type": "particles",
      "emit": "wave",
      "count": 900,
      "rate": "40 + 600*max(0, air - 0.8)",
      "speed": 0.05,
      "gravity": -0.12,
      "flow": 1,
      "life": 2.5,
      "size": 1.8,
      "color": "palette(i)",
      "alpha": 0.8
    }
  ],
  "post": {
    "bloom": 0.9,
    "vignette": 0.4
  }
}
