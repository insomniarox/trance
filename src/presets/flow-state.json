{
  "name": "Flow State",
  "author": "Trance",
  "description": "A white waveform dissolving into slow currents, colored by brightness.",
  "palette": "aurora",
  "frame": "fx = 3 + 2*sin(time*0.13)\nfy = 3 + 2*cos(time*0.11)",
  "feedback": {
    "decay": 0.988,
    "edge": "wrap"
  },
  "pixel": "dx = 0.006*sin(y*fy + time*0.5) + 0.002*sin(x*7 - time)\ndy = 0.006*cos(x*fx - time*0.4)",
  "layers": [
    {
      "type": "wave",
      "shape": "line",
      "color": "white",
      "alpha": 0.9,
      "thickness": 3,
      "scale": "0.35 + 0.2*bass_att",
      "smooth": 0.5,
      "angle": "time*0.07"
    }
  ],
  "post": {
    "colorize": 1,
    "bloom": 0.5
  }
}
