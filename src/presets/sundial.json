      "alpha2": 0.3,
      "border": "palette(0.15)",
      "borderAlpha": 0.7,
      "borderWidth": 2,
      "blend": "over"
    },
    {
      "type": "shape",
      "sides": 4,
      "instances": 12,
      "code": "a = n*tau/count\nx = 0.66*cos(a)\ny = 0.66*sin(a)\nangle = a\nradius = 0.03 + 0.03*min(v*1.5, 1)\na = 0.3 + 0.7*min(v*1.5, 1)",
