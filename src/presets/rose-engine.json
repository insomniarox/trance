{
  "name": "Rose Engine",
  "author": "Trance",
  "description": "Guilloché, the engraving on a watch dial: one outline turned again and again round a centre that wanders, until the copies weave into a rosette. The cymbals and hats turn the lathe, the bass opens the pattern, and the picture is mirrored into four.",
  "palette": "orchid",
  "init": "ph = rand(6)",
  "frame": "turn = turn + dt*(0.03 + 0.25*min(treb_att, 2))\nwob = wob + dt*(0.02 + 0.08*min(bass_att, 2))",
  "feedback": {
    "decay": 0.72,
    "zoom": 1.004,
    "rot": 0.001,
    "edge": "black"
  },
  "layers": [
    {
      "type": "shape",
      "sides": 5,
      "instances": 60,
      "x": "0.14*cos(n*tau/60*3 + wob)",
      "y": "0.14*sin(n*tau/60*2 + wob*1.3)",
      "radius": "0.5 + 0.06*min(bass_att, 2)",
      "angle": "n*tau/60 + turn",
      "color": "black",
      "alpha": 0,
      "border": "palette(0.35 + 0.5*t)",
      "borderAlpha": 0.35,
      "borderWidth": 1.1,
      "blend": "add"
    },
    {
      "type": "shape",
      "sides": 7,
      "instances": 36,
      "x": "0.05*cos(n*tau/36*4 - wob)",
      "y": "0.05*sin(n*tau/36*4 - wob)",
      "radius": "0.2 + 0.04*v",
      "angle": "-n*tau/36 - turn*1.5 + ph",
      "color": "black",
      "alpha": 0,
      "border": "palette(0.7 + 0.3*t)",
      "borderAlpha": 0.45,
      "borderWidth": 1,
      "blend": "add"
    }
  ],
  "post": {
    "mirror": "quad",
    "bloom": 0.5,
    "bloomThreshold": 0.6,
    "vignette": 0.45
  }
}
