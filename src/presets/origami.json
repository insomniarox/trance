{
  "name": "Origami",
  "author": "Trance",
  "description": "A sheet of indigo paper with the spectrum running across it, folding itself into a tube and flat again as the camera turns, its highest creases catching a vermilion edge.",
  "palette": "washi",
  "feedback": {
    "decay": 0.85,
    "zoom": 0.998,
    "rot": 0.002,
    "blur": 0.2
  },
  "background": {
    "style": "gradient",
    "intensity": 0.2,
    "tint": 0.05,
    "spread": 0.15
  },
  "layers": [
    {
      "type": "wireframe",
      "form": "sheet",
      "form2": "tube",
      "morph": "0.5 + 0.5*sin(time*0.15)",
      "style": "lines",
      "bins": 64,
      "rows": 32,
      "speed": 20,
      "yaw": "time*0.12",
      "pitch": 0.4,
      "distance": 3,
      "radius": 0.7,
      "thickness": 1.6,
      "color": "palette(0.35 + 0.6*v)",
      "alpha": 0.9,
      "fog": 0.5
    },
    {
      "type": "wireframe",
      "form": "ring",
      "style": "dots",
      "bins": 48,
      "rows": 24,
      "radius": 1.3,
      "yaw": "-time*0.08",
      "pitch": 0.9,
      "distance": 3,
      "thickness": 2,
      "color": "palette(0.6 + 0.3*v)",
      "alpha": 0.4,
      "fog": 0.7
    }
  ],
  "post": {
    "bloom": 0.4,
    "vignette": 0.4
  }
}
