{
  "name": "Whitecaps",
  "author": "Trance",
  "description": "A sea of spectrum seen from a slowly circling gull: calm where the music is quiet, crests where a note stands out, and spray thrown off the newest wave.",
  "palette": "ocean",
  "init": "ph = rand(6)\ndir = rand() < 0.5 ? -1 : 1",
  "feedback": {
    "decay": 0.72,
    "blur": 0.3,
    "dy": 0.0015,
    "edge": "black"
  },
  "background": {
    "style": "gradient",
    "intensity": 0.22,
    "tint": 0.1,
    "spread": 0.25,
    "speed": 0.3
  },
  "layers": [
    {
      "type": "wireframe",
      "form": "sheet",
      "bins": 56,
      "rows": 40,
      "speed": 16,
      "fade": 0.5,
      "height": "0.55 + 0.1*bass_att",
      "width": 1.6,
      "depth": 1.5,
      "yaw": "ph + dir*time*0.11",
      "pitch": "0.42 + 0.14*sin(time*0.17 + ph)",
      "distance": 3.6,
      "size": 0.85,
      "y": -0.05,
      "thickness": 1.3,
      "fog": 0.7,
      "color": "palette(0.42 + 0.5*min(v, 1) + 0.08*i)",
      "alpha": 0.9
    },
    {
      "type": "particles",
      "emit": "wave",
      "count": 700,
      "rate": "30 + 500*beat",
      "speed": 0.25,
      "angle": 1.57,
      "spread": 1.2,
      "gravity": 0.5,
      "drag": 1,
      "life": 1.6,
      "size": 1.8,
      "color": "palette(0.8 + 0.15*i)",
      "alpha": 0.8
    }
  ],
  "post": {
    "bloom": 0.9,
    "bloomThreshold": 0.4,
    "vignette": 0.45
  }
}
