{
  "name": "Canopy",
  "author": "Trance",
  "description": "Under the trees in a wind. Leaves and seeds ride the gusts, the gusts themselves faintly drawn as strokes, and the cymbals and hiss of the music shake more loose. The picture folds back on itself at the edges, as a forest does.",
  "palette": "viridis",
  "frame": "gust = gust + dt*(0.1 + 0.4*min(air_att, 2))",
  "feedback": {
    "decay": 0.9,
    "dy": -0.0012,
    "warp": 0.5,
    "warpScale": 1.5,
    "warpSpeed": 0.5,
    "blur": 0.2,
    "edge": "mirror"
  },
  "background": {
    "style": "gradient",
    "intensity": 0.2,
    "tint": 0.25,
    "spread": 0.3,
    "speed": 0.3
  },
  "layers": [
    {
      "type": "vectors",
      "cols": 24,
      "rows": 14,
      "length": 2.5,
      "thickness": 1.2,
      "color": "palette(0.3 + 0.4*v)",
      "alpha": 0.18
    },
    {
      "type": "particles",
      "emit": "screen",
      "count": 1400,
      "rate": "60 + 700*max(0, air_att - 0.6)",
      "speed": 0.05,
      "gravity": -0.06,
      "drag": 0.8,
      "flow": 1,
      "field": "0.8 + 0.6*sin(gust)",
      "fieldScale": 2.2,
      "fieldSpeed": 0.4,
      "life": 4,
      "size": 3.2,
      "color": "palette(0.15 + 0.8*i)",
      "alpha": 0.85
    },
    {
      "type": "particles",
      "emit": "screen",
      "count": 600,
      "rate": "30 + 300*beat",
      "speed": 0.02,
      "gravity": 0.04,
      "drag": 1,
      "flow": 1,
      "field": 0.4,
      "life": 3,
      "size": 1.3,
      "color": "palette(0.9 + 0.1*i)",
      "alpha": 0.8
    }
  ],
  "post": {
    "bloom": 0.6,
    "bloomThreshold": 0.55,
    "vignette": 0.5
  }
}
