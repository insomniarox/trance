{
  "name": "Windfall",
  "author": "Trance",
  "description": "An autumn gale. Leaves are torn off and tumble across the screen in the gusts, harder and faster when the bass hits, curling in eddies as they go, while the long grass at the foot bends with the music.",
  "palette": "autumn",
  "init": "ph = rand(6)\nway = rand() < 0.5 ? -1 : 1",
  "frame": "gust = 0.5 + 0.8*min(bass_att, 2)\nblow = blow + dt*gust*0.12",
  "feedback": {
    "decay": 0.88,
    "dx": "way*0.0025*gust",
    "warp": 0.3,
    "warpScale": 1.4,
    "warpSpeed": 0.5,
    "blur": 0.2,
    "edge": "black"
  },
  "background": {
    "style": "gradient",
    "intensity": 0.26,
    "tint": 0.1,
    "spread": 0.25,
    "speed": 0.15
  },
  "layers": [
    {
      "type": "particles",
      "emit": "point",
      "x": "-way*(aspect + 0.2)",
      "y": 0.2,
      "area": 1.1,
      "count": 1400,
      "rate": "60 + 260*min(bass_att, 2)",
      "speed": "0.4 + 0.3*gust",
      "angle": "way > 0 ? 0 : 3.1416",
      "spread": 0.5,
      "gravity": 0.12,
      "drag": 0.3,
      "field": 1.3,
      "fieldScale": 2.2,
      "fieldSpeed": 0.5,
      "life": 7,
      "size": 7,
      "color": "palette(i)",
      "alpha": 1,
      "additive": false
    },
    {
      "type": "shape",
      "sides": 5,
      "instances": 20,
      "x": "way*aspect*1.2*(2*fract(blow*(0.7 + 0.8*noise(n*1.9)) + n*0.618034) - 1)",
      "y": "0.85 - 1.6*fract(n*0.381966 + blow*0.3*(0.5 + noise(n*3.1))) + 0.06*sin(blow*20 + n)",
      "radius": "0.035 + 0.02*noise(n*2.7)",
      "angle": "blow*(6 + 6*noise(n*0.7))*way + n",
      "color": "palette(n*0.21)",
      "alpha": 1,
      "color2": "palette(n*0.21 + 0.1)",
      "alpha2": 1,
      "additive": false
    },
    {
      "type": "bars",
      "layout": "bottom",
      "count": 96,
      "width": 1,
      "height": 0.3,
      "gap": 0.7,
      "fade": 0.5,
      "peaks": false,
      "symmetric": true,
      "color": "palette(0.62 + 0.12*t)",
      "alpha": 1
    }
  ],
  "post": {
    "bloom": 0.35,
    "bloomThreshold": 0.65,
    "saturation": 1.1,
    "vignette": 0.55
  }
}
