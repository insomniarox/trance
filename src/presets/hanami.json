{
  "name": "Hanami",
  "author": "Trance",
  "description": "A night under the cherry trees. Petals drift down past a pale moon and swirl up again in the gusts of the bass, whole blossoms turning as they fall, and a few green leaves among them catch the cymbals.",
  "palette": "sakura",
  "init": "ph = rand(6)",
  "frame": "fall = fall + dt*(0.04 + 0.04*min(vol_att, 2))",
  "feedback": {
    "decay": 0.82,
    "dy": -0.0008,
    "warp": "0.25 + 0.2*min(bass_att, 2)",
    "warpScale": 1.2,
    "warpSpeed": 0.4,
    "blur": 0.25,
    "edge": "black"
  },
  "background": {
    "style": "gradient",
    "intensity": 0.18,
    "tint": 0.1,
    "spread": 0.2,
    "speed": 0.1
  },
  "layers": [
    {
      "type": "shape",
      "sides": 64,
      "x": "aspect*0.45",
      "y": 0.45,
      "radius": "0.2 + 0.01*min(bass_att, 2)",
      "color": "palette(0.66)",
      "alpha": 0.25,
      "color2": "palette(0.6)",
      "alpha2": 0,
      "additive": false
    },
    {
      "type": "particles",
      "emit": "point",
      "x": 0,
      "y": 1.15,
      "area": 1.6,
      "count": 1800,
      "rate": "90 + 200*min(bass_att, 2)",
      "speed": 0.08,
      "angle": -1.5708,
      "spread": 1.2,
      "gravity": 0.08,
      "drag": 0.9,
      "field": "0.8 + 0.8*min(bass_att, 2)",
      "fieldScale": 2,
      "fieldSpeed": 0.4,
      "life": 8,
      "size": 5,
      "color": "palette(0.42 + 0.16*i)",
      "alpha": 1,
      "additive": false
    },
    {
      "type": "shape",
      "sides": 5,
      "instances": 16,
      "x": "aspect*(2*fract(n*0.618034 + 0.08*sin(fall*7 + n)) - 1)",
      "y": "1.1 - 2.2*fract(fall*(0.6 + 0.8*noise(n*1.3)) + n*0.381966)",
      "radius": "0.04 + 0.015*noise(n*2.1)",
      "angle": "fall*(8 + 8*noise(n))*(n % 2 == 0 ? 1 : -1)",
      "color": "palette(0.58)",
      "alpha": 1,
      "color2": "palette(0.44 + 0.06*n/count)",
      "alpha2": 0.95,
      "additive": false
    },
    {
      "type": "particles",
      "emit": "screen",
      "count": 200,
      "rate": "2 + 60*max(0, air - 0.8)",
      "speed": 0.05,
      "gravity": 0.06,
      "drag": 1,
      "field": 0.6,
      "life": 3,
      "size": 4,
      "color": "palette(0.97)",
      "alpha": 0.8,
      "additive": false
    }
  ],
  "post": {
    "bloom": 0.25,
    "bloomThreshold": 0.7,
    "vignette": 0.6,
    "saturation": 1.2
  }
