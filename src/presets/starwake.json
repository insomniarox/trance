{
  "name": "Starwake",
  "author": "Trance",
  "description": "A ring of sound throwing streaks outward through a field of stars.",
  "palette": "ice",
  "feedback": {
    "decay": 0.955,
    "zoom": "1.02 + 0.03*bass_att",
    "rot": "0.004*sin(time*0.2)",
    "edge": "black",
    "darkenCenter": true
  },
  "background": {
    "style": "stars",
    "intensity": "0.7 + 0.5*treb_att",
    "tint": 0.6,
    "spread": 0.3,
    "scale": 1.2,
    "speed": 2
  },
  "layers": [
    {
      "type": "wave",
      "shape": "circle",
      "radius": "0.25 + 0.06*bass_att",
      "scale": 0.2,
      "smooth": 0.4,
      "thickness": 3,
      "color": "palette(0.55 + 0.4*abs(v))",
      "angle": "-time*0.15"
    },
    {
      "type": "particles",
      "emit": "wave",
      "count": 1500,
      "rate": "120 + 1500*beat",
      "speed": 0.05,
      "pull": -2.6,
      "drag": 0.6,
      "flow": 1,
      "life": 2.4,
      "size": 2.4,
      "streak": 0.07,
      "color": "palette(0.6 + 0.35*i)"
    }
  ],
  "post": {
    "bloom": 1.1,
    "chroma": 0.6,
    "vignette": 0.4
  }
}
