{
  "name": "Duckweed",
  "author": "Trance",
  "description": "A pond's skin of tiny leaves turning on a slow eddy, with lily pads riding it and the water itself drawn in its own trails. The warm middle of the music, the low voices and the body of the guitars, stirs the current.",
  "palette": "forest",
  "init": "ph = rand(6)",
  "frame": "stir = stir + dt*(0.1 + 0.5*min(lowmid_att, 2))",
  "feedback": {
    "decay": 0.93,
    "blur": 0.2,
    "edge": "black"
  },
  "pixel": "rot = 0.004*sin(rad*3 - stir)\nzoom = 1 + 0.002*sin(ang*2 + stir*0.7)",
  "background": {
    "style": "nebula",
    "intensity": 0.18,
    "tint": 0.1,
    "spread": 0.25,
    "scale": 1.6,
    "speed": 0.2
  },
  "layers": [
    {
      "type": "particles",
      "emit": "screen",
      "count": 2400,
      "rate": 300,
      "speed": 0.01,
      "drag": 2,
      "flow": 1,
      "field": "0.3 + 0.5*min(lowmid_att, 2)",
      "fieldScale": 2.5,
      "fieldSpeed": 0.2,
      "life": 4,
      "size": 2.2,
      "color": "palette(0.35 + 0.4*i)",
      "alpha": 0.7
    },
    {
      "type": "shape",
      "sides": 24,
      "instances": 9,
      "x": "aspect*0.8*sin(stir*0.2 + n*2.4 + ph)",
      "y": "0.7*cos(stir*0.17 + n*1.7)",
      "radius": "0.05 + 0.04*noise(n*2.1)",
      "angle": "stir*0.3 + n",
      "color": "palette(0.45 + 0.2*t)",
      "alpha": 0.35,
      "color2": "palette(0.6)",
      "alpha2": 0.6,
      "border": "palette(0.8)",
      "borderAlpha": 0.5,
      "borderWidth": 1.5,
      "blend": "add"
    },
    {
      "type": "particles",
      "emit": "point",
      "x": "aspect*0.8*sin(stir*0.2 + ph)",
      "y": "0.7*cos(stir*0.17)",
      "count": 400,
      "rate": "5 + 500*beat",
      "speed": 0.2,
      "drag": 1,
      "flow": 1,
      "life": 2,
      "size": 1.4,
      "color": "palette(0.95)",
      "alpha": 0.8
    }
  ],
  "post": {
    "bloom": 0.55,
    "bloomThreshold": 0.55,
    "vignette": 0.5
  }
}
