{
  "name": "Planetarium",
  "author": "Trance",
  "description": "Lying back under the dome of a planetarium: the dome's ribs are the last few seconds of the music, swelling with the bass, and a sky of points turns across them, quicker and brighter with the cymbals.",
  "palette": "twilight",
  "init": "ph = rand(6)",
  "frame": "sky = sky + dt*(0.04 + 0.12*min(treb_att, 2))",
  "feedback": {
    "decay": 0.6,
    "blur": 0.2,
    "edge": "black"
  },
  "layers": [
    {
      "type": "wireframe",
      "form": "sphere",
      "style": "mesh",
      "bins": 40,
      "rows": 24,
      "speed": 10,
      "low": 40,
      "high": 3000,
      "fade": 0.5,
      "smooth": 0.3,
      "radius": 1,
      "height": "0.12 + 0.06*min(bass_att, 2)",
      "yaw": "ph + time*0.02",
      "pitch": 1.25,
      "roll": 0,
      "distance": 0.35,
      "size": 1,
      "thickness": 1.5,
      "fog": 0.4,
      "color": "palette(0.25 + 0.2*min(v, 1))",
      "alpha": 0.9
    },
    {
      "type": "wireframe",
      "form": "sphere",
      "style": "dots",
      "bins": 64,
      "rows": 36,
      "speed": 6,
      "low": 2000,
      "high": 14000,
      "fade": 0.8,
      "smooth": 0.1,
      "tilt": 0.6,
      "radius": 0.9,
      "height": 0.05,
      "yaw": "ph + sky",
      "pitch": 1.25,
      "roll": 0.3,
      "distance": 0.35,
      "size": 1,
      "thickness": 3,
      "fog": 0.2,
      "color": "palette(0.02 + 0.12*min(v, 1))",
      "alpha": 1
    }
  ],
  "post": {
    "bloom": 1,
    "bloomThreshold": 0.4,
    "brightness": 1.3,
    "vignette": 0.5
  }
}
