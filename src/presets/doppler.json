{
  "name": "Doppler",
  "author": "Trance",
  "description": "A weather radar at night. The beam sweeps round with the spectrum along it and leaves a fading trail, storm cells drift across the screen, bright where the bass hits hardest, and the rings mark the range.",
  "palette": "turbo",
  "init": "ph = rand(6)\nway = rand() < 0.5 ? -1 : 1",
  "frame": "beam = beam + way*dt*(0.9 + 0.5*min(bass_att, 2))",
  "feedback": {
    "decay": 0.975,
    "edge": "black"
  },
  "background": {
    "style": "nebula",
    "intensity": "0.12 + 0.2*min(bass_att, 2)",
    "tint": 0.35,
    "spread": 0.5,
    "scale": 1.6,
    "speed": 0.35
  },
  "layers": [
    {
      "type": "wave",
      "source": "spectrum",
      "shape": "line",
      "x": "0.55*cos(beam)",
      "y": "0.55*sin(beam)",
      "width": 0.55,
      "angle": "beam",
      "scale": 0.08,
      "smooth": 0.3,
      "thickness": 3,
      "color": "palette(0.3 + 0.7*min(v*2, 1))",
      "alpha": 0.9,
      "blend": "add"
    },
    {
      "type": "shape",
      "sides": 64,
      "instances": 4,
      "radius": "0.27*(n + 1)",
      "alpha": 0,
      "alpha2": 0,
      "border": "palette(0.12)",
      "borderAlpha": 0.012,
      "borderWidth": 1,
      "blend": "add"
    },
    {
      "type": "particles",
      "emit": "wave",
      "count": 1500,
      "rate": "40 + 900*beat",
      "speed": 0.01,
      "drag": 2,
      "life": 3,
      "size": 3,
      "color": "palette(0.6 + 0.4*i)",
      "alpha": 0.7,
      "blend": "add"
    }
  ],
  "post": {
    "bloom": 0.5,
    "bloomThreshold": 0.5,
    "vignette": 0.5,
    "scanlines": 0.15
  }
}
