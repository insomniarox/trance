{
  "name": "Blueprint",
  "author": "Trance",
  "description": "A part being drafted in white on blue paper: the spectrum's last few seconds as a wireframe turning on its stand, folding from a tube into a ball and back, over the paper's dot grid, with its spectrum ruled along the foot like a scale.",
  "palette": "ocean",
  "init": "ph = rand(6)",
  "feedback": {
    "decay": 0.55,
    "edge": "black"
  },
  "background": {
    "style": "gradient",
    "intensity": 0.55,
    "tint": 0.3,
    "spread": 0.04,
    "speed": 0
  },
  "layers": [
    {
      "type": "vectors",
      "cols": 40,
      "rows": 22,
      "dots": true,
      "thickness": 2,
      "color": "palette(0.7)",
      "alpha": 0.35
    },
    {
      "type": "wireframe",
      "form": "tube",
      "form2": "sphere",
      "morph": "0.5 - 0.5*cos(time*0.11 + ph)",
      "style": "lines",
      "bins": 40,
      "rows": 28,
      "speed": 12,
      "low": 60,
      "high": 10000,
      "tilt": 6,
      "smooth": 0.3,
      "fade": 0.5,
      "height": "0.35 + 0.15*min(vol_att, 2)",
      "depth": 1.6,
      "radius": 0.6,
      "yaw": "time*0.15 + ph",
      "pitch": "0.35 + 0.1*sin(time*0.07)",
      "distance": 4.5,
      "size": 0.55,
      "y": 0.05,
      "thickness": 1.3,
      "fog": 0.45,
      "color": "palette(0.75 + 0.25*min(v*2, 1))",
      "alpha": 0.95,
      "blend": "add"
    },
    {
      "type": "bars",
      "layout": "bottom",
      "count": 64,
      "width": 0.85,
      "height": 0.1,
      "gap": 0.6,
      "fade": 0,
      "peaks": true,
      "color": "palette(0.9)",
      "alpha": 0.8
    }
  ],
  "post": {
    "bloom": 0.3,
    "bloomThreshold": 0.7,
    "vignette": 0.45,
    "grain": 0.05
  }
}
