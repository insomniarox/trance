{
  "name": "Silver Gelatin",
  "author": "Trance",
  "description": "A print coming up in the developer tray: the spectrum as a field of grains rolling toward the horizon, each leaving a smear that the tray's slow rock carries upward, and all of it toned only in black and white by its brightness. The bass swells the hills.",
  "palette": "mono",
  "feedback": {
    "decay": 0.94,
    "dy": 0.003,
    "warp": 0.25,
    "warpScale": 1.5,
    "warpSpeed": 0.4,
    "blur": 0.35,
    "edge": "black"
  },
  "layers": [
    {
      "type": "terrain",
      "style": "dots",
      "rows": 40,
      "cols": 96,
      "speed": 12,
      "height": "0.5 + 0.2*min(bass_att, 2)",
      "width": 1.8,
      "y": -0.9,
      "horizon": 0.3,
      "depth": 2.5,
      "thickness": 2.2,
      "color": "white",
      "alpha": 0.75
    },
    {
      "type": "wave",
      "shape": "line",
      "y": 0.3,
      "scale": 0.06,
      "smooth": 0.7,
      "thickness": 1.5,
      "color": "white",
      "alpha": 0.5
    }
  ],
  "post": {
    "colorize": 1,
    "colorCurve": 1.3,
    "bloom": 0.3,
    "bloomThreshold": 0.7,
    "contrast": 1.15,
    "grain": 0.12,
    "vignette": 0.7
  }
}
