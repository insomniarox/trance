{
  "name": "Heartbeat",
  "author": "Trance",
  "description": "One soft light that swells with every beat.",
  "palette": "sunset",
  "feedback": {
    "decay": 0.9,
    "zoom": "1.03 + 0.05*beat",
    "edge": "black"
  },
  "layers": [
    {
      "type": "shape",
      "sides": 64,
      "radius": "0.18 + 0.12*beat + 0.05*bass_att",
      "color": "palette(0.55 + 0.1*sin(time))",
      "alpha": "0.2 + 0.3*beat",
      "color2": "palette(0.35)",
      "alpha2": 0,
      "additive": true
    },
    {
      "type": "wave",
      "shape": "circle",
      "radius": "0.35 + 0.1*beat",
      "scale": 0.2,
      "color": "palette(0.8)",
      "thickness": 2.5
    }
  ],
  "post": {
    "bloom": 0.9,
    "echoAlpha": 0.3,
    "echoZoom": 1.8
  }
}
