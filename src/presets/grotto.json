{
  "name": "Grotto",
  "author": "Trance",
  "description": "A cave lit from somewhere out of sight. Stalactites hang from the roof, the voices and leads lengthening them, over stalagmites the bass pushes up from the floor. Water gathers at the tips, drips faster with the cymbals, and bounces where it lands.",
  "palette": "steel",
  "init": "ph = rand(10)",
  "feedback": {
    "decay": 0.7,
    "blur": 0.25,
    "edge": "black"
  },
  "background": {
    "style": "gradient",
    "intensity": 0.12,
    "tint": 0.15,
    "spread": 0.2,
    "speed": 0.2
  },
  "layers": [
    {
      "type": "bars",
      "layout": "top",
      "count": 32,
      "width": 1,
      "gap": 0.35,
      "height": "0.35 + 0.1*min(mid_att, 2)",
      "fade": 0.75,
      "peaks": false,
      "symmetric": true,
      "color": "palette(0.55 + 0.3*t)",
      "alpha": 0.9,
      "point": "v = 0.18 + 0.45*noise(i*0.9 + ph)*(0.6 + v)"
    },
    {
      "type": "particles",
      "emit": "bars",
      "count": 600,
      "rate": "4 + 60*min(treb_att, 2)",
      "speed": 0.02,
      "gravity": 1.6,
      "drag": 0.2,
      "edge": "bounce",
      "life": 2.5,
      "size": 2.6,
      "streak": 0.03,
      "color": "palette(0.8 + 0.057*i)",
      "alpha": 0.9
    },
    {
      "type": "bars",
      "layout": "bottom",
      "count": 28,
      "width": 1,
      "gap": 0.45,
      "height": "0.25 + 0.08*min(bass_att, 2)",
      "fade": 0.75,
      "peaks": false,
      "symmetric": true,
      "color": "palette(0.45 + 0.3*t)",
      "alpha": 0.9,
      "point": "v = 0.15 + 0.5*noise(i*1.3 + ph*2)*(0.5 + v)"
    }
  ],
  "post": {
    "bloom": 0.5,
    "bloomThreshold": 0.6,
    "vignette": 0.6
  }
}
