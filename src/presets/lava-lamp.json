{
  "name": "Lava Lamp",
  "author": "Trance",
  "description": "Six blobs of wax rising and sinking, the largest and slowest for the rumble, the smallest and quickest for the cymbals. Each swells with its own range, and where they meet they melt together.",
  "palette": "magma",
  "init": "h0 = rand(6)\nh1 = rand(6)\nh2 = rand(6)\nh3 = rand(6)\nh4 = rand(6)\nh5 = rand(6)",
  "frame": "h0 = h0 + dt*0.25*(0.3 + 0.7*sub_att)\nh1 = h1 + dt*0.32*(0.3 + 0.7*low_att)\nh2 = h2 + dt*0.4*(0.3 + 0.7*lowmid_att)\nh3 = h3 + dt*0.5*(0.3 + 0.7*highmid_att)\nh4 = h4 + dt*0.62*(0.3 + 0.7*presence_att)\nh5 = h5 + dt*0.78*(0.3 + 0.7*air_att)",
