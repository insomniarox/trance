{
  "name": "Seismograph",
  "author": "Trance",
  "description": "A chart recorder seen in perspective: a row of pens, bass to treble, each drawing its own line back across the ruled paper as the camera drifts round it.",
  "palette": "theme",
  "init": "ph = rand(6)\ndir = rand() < 0.5 ? -1 : 1",
  "frame": "turn = 0.85 + dir*0.4*sin(time*0.09 + ph)\ntip = 0.4 + 0.12*sin(time*0.07 + ph)",
  "feedback": {
    "decay": 0.6,
    "edge": "black"
  },
  "layers": [
    {
      "type": "wireframe",
      "style": "lines",
      "bins": 48,
      "rows": 40,
      "speed": 16,
      "height": 0,
      "width": 1.5,
      "depth": 2.2,
      "yaw": "turn",
      "pitch": "tip",
      "distance": 3.2,
      "y": -0.05,
      "thickness": 1,
      "fog": 0.85,
      "color": "foreground",
      "alpha": 0.16,
      "additive": true
    },
    {
      "type": "wireframe",
      "style": "strands",
      "bins": 14,
      "rows": 40,
      "speed": 16,
      "low": 40,
      "high": 6000,
      "tilt": 6,
      "smooth": 0.15,
      "fade": 0.18,
      "height": "0.38 + 0.08*bass_att",
      "width": 1.5,
      "depth": 2.2,
      "yaw": "turn",
      "pitch": "tip",
      "distance": 3.2,
      "y": -0.05,
      "thickness": 3,
      "fog": 0.7,
      "color": "palette(0.05 + 0.9*t)",
      "alpha": 1
    }
  ],
  "post": {
    "bloom": 1,
    "bloomThreshold": 0.4,
    "vignette": 0.4,
    "scanlines": 0.12
  }
}
