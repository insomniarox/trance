{
  "name": "Siphon",
  "author": "Trance",
  "description": "Looking down a tube of the last few seconds' sound, its walls drawn as threads running away from you and a second, narrower tube of points turning the other way inside it. The picture runs downward as it fades, like something being drawn off. The bass widens the throat.",
  "palette": "ultraviolet",
  "init": "dir = rand() < 0.5 ? -1 : 1",
  "feedback": {
    "decay": 0.82,
    "sx": 0.997,
    "sy": 1.012,
    "dy": -0.002,
    "blur": 0.25,
    "edge": "black"
  },
  "layers": [
    {
      "type": "wireframe",
      "form": "tube",
      "style": "strands",
      "bins": 48,
      "rows": 40,
      "speed": 16,
      "fade": 0.3,
      "radius": "0.5 + 0.08*min(bass_att, 2)",
      "depth": 3,
      "height": 0.25,
      "yaw": "0.15*sin(time*0.1)",
      "pitch": "0.1*cos(time*0.13)",
      "roll": "dir*time*0.15",
      "distance": 1.2,
      "size": 1,
      "thickness": 1.3,
      "fog": 0.8,
      "color": "palette(0.25 + 0.6*min(v, 1) + 0.15*t)",
      "alpha": 0.75
    },
    {
      "type": "wireframe",
      "form": "tube",
      "style": "dots",
      "bins": 32,
      "rows": 24,
      "speed": 22,
      "fade": 0.25,
      "radius": "0.22 + 0.05*min(bass_att, 2)",
      "depth": 3,
      "height": 0.15,
      "yaw": "0.15*sin(time*0.1)",
      "pitch": "0.1*cos(time*0.13)",
      "roll": "-dir*time*0.3",
      "distance": 1.2,
      "size": 1,
      "thickness": 2.4,
      "fog": 0.7,
      "color": "palette(0.6 + 0.4*min(v, 1))",
      "alpha": 0.9
    }
  ],
  "post": {
    "bloom": 0.7,
    "bloomThreshold": 0.5,
    "vignette": 0.6
  }
}
