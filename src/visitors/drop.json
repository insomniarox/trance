{
  "name": "Drop",
  "init": "age = 9\npx = (rand(2) - 1)*0.6\npy = (rand(2) - 1)*0.5",
  "frame": "hit = above(beat, 0.9)*above(age, 0.3)\npx = if(hit, (rand(2) - 1)*0.6, px)\npy = if(hit, (rand(2) - 1)*0.5, py)\nage = if(hit, 0, age + dt)",
  "layers": [
    {
      "type": "shape",
      "sides": 48,
      "instances": 2,
      "x": "px*aspect",
      "y": "py",
      "radius": "0.02 + 0.5*max(0, age - 0.14*n)",
      "alpha": 0,
      "alpha2": 0,
      "border": "palette(0.2 + 0.4*n + time*0.05)",
      "borderAlpha": "clamp(1 - 1.4*age, 0, 1)*above(age, 0.14*n)*(1 - 0.4*n)",
      "borderWidth": "2.5 - n",
      "blend": "add"
    }
  ]
}
