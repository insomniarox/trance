{
  "name": "Satellite",
  "init": "k = int(rand(6))\nfx = 0.13 + rand(0.12)\nfy = 0.1 + rand(0.12)\nph = rand(6)\nspin = 0.3 + rand(0.5)",
  "frame": "level = if(k < 1, sub_att, if(k < 2, low_att, if(k < 3, lowmid_att, if(k < 4, highmid_att, if(k < 5, presence_att, air_att)))))",
  "layers": [
    {
      "type": "wireframe",
      "form": "sphere",
      "style": "lines",
      "bins": 24,
      "rows": 10,
      "speed": 10,
      "low": "if(k < 1, 20, if(k < 2, 60, if(k < 3, 200, if(k < 4, 600, if(k < 5, 2000, 6000)))))",
      "high": "if(k < 1, 60, if(k < 2, 200, if(k < 3, 600, if(k < 4, 2000, if(k < 5, 6000, 16000)))))",
      "tilt": 1,
      "smooth": 0.3,
      "fade": 0.3,
      "height": 0.3,
      "radius": 0.5,
      "yaw": "time*spin",
      "pitch": 0.4,
      "distance": 3,
      "size": "0.09 + 0.04*min(level, 2)",
      "x": "aspect*0.72*sin(time*fx + ph)",
      "y": "0.68*cos(time*fy + ph*1.3)",
      "thickness": 1.1,
      "fog": 0.5,
      "color": "palette(k/6 + 0.15*min(v, 1) + time*0.03)",
      "alpha": 0.85
    }
  ]
}
