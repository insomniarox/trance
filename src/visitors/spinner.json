{
  "name": "Spinner",
  "init": "corners = 3 + int(rand(4))\npx = (rand(2) - 1)*0.6\npy = (rand(2) - 1)*0.5\nturn = 0.4 + rand(1)",
  "layers": [
    {
      "type": "shape",
      "sides": "corners",
      "x": "px*aspect",
      "y": "py",
      "radius": "0.14 + 0.06*bass_att",
      "angle": "time*turn",
      "alpha": 0,
      "alpha2": 0,
      "border": "palette(time*0.12)",
      "borderAlpha": 0.9,
      "borderWidth": 2.5,
      "blend": "add"
    }
  ]
}
