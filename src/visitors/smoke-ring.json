{
  "name": "Smoke Ring",
  "init": "x0 = (rand(2) - 1)*0.6\ny0 = -0.5 + rand(0.4)\nph = rand(6)",
  "layers": [
    {
      "type": "wireframe",
      "form": "ring",
      "style": "lines",
      "bins": 40,
      "rows": 8,
      "speed": 12,
      "fade": 0.4,
      "radius": 0.6,
      "height": "0.05 + 0.1*min(presence_att, 2)",
      "yaw": "ph + time*0.2",
      "pitch": "1.05 + 0.1*sin(time*0.3)",
      "distance": 3,
      "size": "0.22 + 0.25*progress",
      "x": "aspect*(x0 + 0.1*sin(time*0.2 + ph))",
      "y": "y0 + 0.6*progress",
      "thickness": 1.3,
      "fog": 0.4,
      "color": "palette(0.4 + 0.4*t + time*0.02)",
      "alpha": "0.85 - 0.4*progress",
      "point": "a = a*smoothstep(0.55, 0.85, i)"
    }
  ]
}
