{
  "name": "Spindle",
  "init": "fx = 0.12 + rand(0.1)\nfy = 0.1 + rand(0.1)\nph = rand(6)\ndir = rand() < 0.5 ? -1 : 1",
  "frame": "spin = spin + dt*dir*(0.4 + 1.2*min(mid_att, 2))",
  "layers": [
    {
      "type": "wireframe",
      "form": "tube",
      "style": "dots",
      "bins": 20,
      "rows": 12,
      "speed": 14,
      "fade": 0.3,
      "radius": 0.35,
      "depth": 1.2,
      "height": 0.25,
      "yaw": "spin",
      "pitch": "0.45 + 0.1*sin(time*0.5)",
      "roll": "0.2*sin(time*0.3 + ph)",
      "distance": 3,
      "size": "0.2 + 0.04*min(mid_att, 2)",
      "x": "aspect*0.65*sin(time*fx + ph)",
      "y": "0.55*cos(time*fy + ph)",
      "thickness": 2.2,
      "fog": 0.6,
      "color": "palette(0.3 + 0.5*min(v, 1) + time*0.03)",
      "alpha": 0.9
    }
  ]
}
